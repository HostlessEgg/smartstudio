# Backend environment variables (example)

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smartstudio_lms

# Auth
JWT_SECRET=change_me

# Rate limiting (optional)
RATE_LIMITS_DISABLED=false
GLOBAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
QUIZ_SUBMIT_RATE_LIMIT_MAX=30
FORUM_POST_RATE_LIMIT_MAX=30

# Feature flags
APP_ENV=development

# S3 uploads (optional)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upload limits
UPLOAD_MAX_MB=20
